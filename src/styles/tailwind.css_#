@tailwind base;
@tailwind components;
@tailwind utilities;

/* Custom base styles that override Tailwind's base layer */
@layer base {
  :root {
    --primary-blue: #2563eb;
    --primary-blue-dark: #1d4ed8;
    --text-dark: #1f2937;
    --text-light: #4b5563;
    --bg-light: #f9fafb;
    --border-color: #e5e7eb;
  }

  body {
    font-family: 'Assistant', 'Assistant-Fallback', 'Segoe UI', 'Roboto', 'Helvetica Neue', 'Arial', sans-serif;
    background-color: var(--bg-light);
    color: var(--text-dark);
    padding-bottom: 80px; /* Add padding to prevent footer overlap */
  }

  /* Ensure SVG elements don't get oversized */
  svg {
    max-width: 100%;
    max-height: 100%;
  }
}
